{
  "name": "@jptt/tactical-ds",
  "version": "1.0.0",
  "private": true,
  "description": "Design system de JP Tactical Trading. Componentes React sobre el CSS real del sitio.",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
